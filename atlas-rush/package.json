{
  "name": "@mission-critical/atlas-rush",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && vite build --config graphics.vite.config.ts",
    "preview": "vite preview",
