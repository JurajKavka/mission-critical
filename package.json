{
  "name": "mission-critical",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Mission Critical arcade catalog.",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev --open",
    "build": "astro build",
    "preview": "astro preview",
    "lint": "eslint \"src/**/*.{astro,ts}\" astro.config.mjs eslint.config.js vitest.config.ts",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check && astro check",
    "clean": "rm -rf node_modules dist .astro .vite .vite-cache .cache"
  },
  "dependencies": {
    "astro": "^5.13.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-plugin-astro": "^1.7.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.72.1",
    "vitest": "4.1.12"
  }
}
