{
  "name": "@mission-critical/www",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Mission Critical arcade catalog.",
  "scripts": {
    "prepare:games": "npm --prefix ../asteroids run build",
    "predev": "npm run prepare:games",
    "dev": "astro dev",
    "prestart": "npm run prepare:games",
    "start": "astro dev --open",
    "prebuild": "npm run prepare:games",
    "build": "astro build",
    "preview": "astro preview",
    "lint": "eslint \"src/**/*.{astro,ts}\" astro.config.mjs eslint.config.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check && astro check"
  },
  "dependencies": {
    "astro": "^5.13.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-plugin-astro": "^1.7.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.72.1"
  }
}
