---
import type { Game } from '../data/games';
import { getGameUrl } from '../lib/url';

interface Props {
  game: Game;
  index: number;
}

const { game, index } = Astro.props;
const missionNumber = String(index + 1).padStart(2, '0');
const gameUrl = getGameUrl(game.id);
---

<article class={`game-card game-card--${game.accent}`}>
  <div class="game-card-frame">
    <a class="game-visual" href={gameUrl} aria-label={`Launch ${game.name}`}>
      <div class="visual-grid" aria-hidden="true"></div>
      <div class="orbit orbit--one" aria-hidden="true"></div>
      <div class="orbit orbit--two" aria-hidden="true"></div>
      <svg
        class="asteroid asteroid--large"
        viewBox="0 0 120 120"
        aria-hidden="true"
      >
        <path d="M27 10 62 4l31 17 21 29-9 35-27 27-39-2L8 83 4 45Z"></path>
        <path
          d="m27 10 12 25 35 4 19-18M8 83l30-10 40 39M105 85 74 72l4-33"
        ></path>
      </svg>
      <svg
        class="asteroid asteroid--small"
        viewBox="0 0 80 80"
        aria-hidden="true"
      >
        <path d="m21 6 34 2 20 24-9 33-30 10L8 59 5 25Z"></path>
        <path d="m21 6 8 22 30 7 16-3M8 59l28-11 30 17"></path>
      </svg>
      <div class="ship" aria-hidden="true">
        <span class="ship-body"></span>
        <span class="ship-trail"></span>
      </div>
      <div class="projectile" aria-hidden="true"></div>
      <div class="visual-index" aria-hidden="true">
        {missionNumber}
      </div>
      <div class="visual-label" aria-hidden="true">
        <span>Live telemetry</span>
        <i></i>
      </div>
    </a>

    <div class="game-details">
      <div class="game-meta">
        <span class="game-designation">{game.designation}</span>
        <span class="game-status">
          <i></i>
          {game.status}
        </span>
      </div>

      <div>
        <p class="game-kicker">Active mission</p>
        <h2>{game.name}</h2>
        <p class="game-description">{game.description}</p>
      </div>

      <dl class="mission-data">
        <div>
          <dt>Objective</dt>
          <dd>{game.objective}</dd>
        </div>
        <div>
          <dt>Input</dt>
          <dd>{game.controls.join(' + ')}</dd>
        </div>
      </dl>

      <a class="launch-button" href={gameUrl}>
        <span>Launch mission</span>
        <span class="launch-icon" aria-hidden="true"> → </span>
      </a>
    </div>
  </div>
</article>
