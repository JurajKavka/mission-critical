---
interface Props {
  label: string;
  id?: string;
  type?: 'button' | 'submit';
}

const { label, id, type = 'button' } = Astro.props;
---

<button class="action-button" id={id} type={type}>
  <span data-action-label>{label}</span
  ><span class="action-arrow" aria-hidden="true">↗</span>
</button>

<style>
  .action-button {
    border: 1px solid #69fbff;
    background: rgba(21, 97, 116, 0.2);
    color: #f4feff;
    padding: 12px 16px;
    font: inherit;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    transition: background 0.2s;
    cursor: pointer;
  }

  .action-button:hover {
    background: rgba(31, 142, 161, 0.35);
  }

  .action-button:focus-visible {
    border-color: #69fbff;
    outline: none;
    box-shadow: inset 0 0 0 2px #69fbff;
  }

  @media (prefers-reduced-motion: reduce) {
    .action-button {
      transition-duration: 0.01ms;
    }
  }

  .action-arrow {
    color: #69fbff;
    margin-left: 8px;
  }
</style>
