---
import styles from './ActionButton.module.css';

interface Props {
  label: string;
  id?: string;
  type?: 'button' | 'submit';
  disabled?: boolean;
}

const { label, id, type = 'button', disabled = false } = Astro.props;
---

<button
  class:list={['action-button', styles.button]}
  id={id}
  type={type}
  disabled={disabled}
>
  <span data-action-label>{label}</span
  ><span class={styles.arrow} aria-hidden="true">↗</span>
</button>
