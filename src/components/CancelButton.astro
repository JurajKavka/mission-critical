---
interface Props {
  label: string;
  id?: string;
}

const { label, id } = Astro.props;
---

<button class="cancel-button" id={id} type="button">
  {label}<span aria-hidden="true">→</span>
</button>

<style>
  .cancel-button {
    border: 1px solid rgba(157, 181, 200, 0.3);
    background: transparent;
    color: #9db5c8;
    padding: 12px 16px;
    font: inherit;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    white-space: nowrap;
    transition: background 0.2s;
    cursor: pointer;
  }

  .cancel-button:hover {
    background: rgba(31, 142, 161, 0.35);
  }

  .cancel-button:focus-visible {
    border-color: #69fbff;
    outline: none;
    box-shadow: inset 0 0 0 2px #69fbff;
  }

  .cancel-button span {
    color: #69fbff;
    margin-left: 8px;
  }

  @media (prefers-reduced-motion: reduce) {
    .cancel-button {
      transition-duration: 0.01ms;
    }
  }
</style>
