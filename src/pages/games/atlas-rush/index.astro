---
import ActionButton from '../../../components/ActionButton.astro';
import GameBreadcrumb from '../../../components/GameBreadcrumb.astro';
import CancelButton from '../../../components/CancelButton.astro';
import { home } from '../../../lib/url';
import { levels } from './_game/config';
import { regions } from './_game/regions';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#02040b" />
    <title>Atlas Rush // Mission Critical</title>
  </head>
  <body>
    <div id="app">
      <header class="hud">
        <div>
          <p class="brand">
            <a href={home()}>Mission Critical</a> <span>//</span> Atlas Rush
          </p>
          <p class="label" id="region-label">Sector 01 / Africa</p>
        </div>
        <div class="hud-stats">
          <div class="telemetry">
            <span class="label">Identified</span
            ><strong id="progress">00&nbsp;/&nbsp;00</strong>
          </div>
          <div id="timer-slot"></div>
        </div>
      </header>
      <main class="playfield">
        <div class="map-heading">
          <span>Survey grid / 01</span>
          <div class="map-heading-controls">
            <span id="region-code">AFR · 54</span>
            <button
              class="exit-button"
              id="exit-game"
              type="button"
              aria-label="End game"
              hidden
            >
              ×
            </button>
          </div>
        </div>
        <div id="map-slot" class="map-slot"></div>
        <div class="map-key">
          <span><i class="key-target"></i> Identify</span>
          <span><i class="key-guessed"></i> Identified</span>
          <span id="island-markers">Island nations shown as markers</span>
          <span id="learning-hint" hidden
            >Learning mode / Select the highlighted area to reveal its
            name</span
          >
        </div>
      </main>
      <footer class="command">
        <div class="command-index">01 / 54</div>
        <form id="answer-form" autocomplete="off">
          <input
            id="answer"
            name="answer"
            type="text"
            placeholder="Enter country name in English"
            aria-describedby="feedback"
            required
          />
          <ActionButton label="Identify" type="submit" />
          <CancelButton id="skip" label="Skip" />
        </form>
        <p id="feedback" class="feedback" aria-live="polite">
          Type a name, then press Enter. Skip to return to a country later.
        </p>
      </footer>
      <dialog
        class="panel exit-confirm"
        id="exit-confirm"
        aria-labelledby="exit-title"
        aria-describedby="exit-description"
      >
        <p class="eyebrow">Survey paused</p>
        <h2 id="exit-title">End this game?</h2>
        <p class="panel-copy" id="exit-description">
          Your progress in this round will be lost.
        </p>
        <div class="exit-actions">
          <ActionButton id="confirm-exit" label="End game" />
          <CancelButton id="resume-game" label="Continue" />
        </div>
      </dialog>
      <div class="overlay" id="overlay">
        <GameBreadcrumb gameName="Atlas Rush" />
        <section
          class="panel start-panel"
          role="dialog"
          aria-modal="true"
          aria-labelledby="start-title"
        >
          <p class="eyebrow">Sector 01</p>
          <h1 id="start-title">Atlas <em>Rush</em></h1>
          <p class="panel-copy">
            Identify countries or US states before the clock runs out.
          </p>
          <fieldset class="region-select">
            <legend>Select a region</legend>
            {regions.map((region, index) => <label class="region-option">
              <input
                type="radio"
                name="region"
                value={region.id}
                checked={index === 0}
              />
              <span>{region.name}</span>
            </label>)}
          </fieldset>
          <fieldset class="region-select level-select">
            <legend>Select a level</legend>
            {levels.map((level, index) => <label class="region-option">
              <input
                type="radio"
                name="level"
                value={level.id}
                checked={index === 0}
              />
              <span>{level.label}</span>
            </label>)}
          </fieldset>
          <ActionButton label="Start survey" />
          <label class="learning-option"
            ><input id="learning-mode" type="checkbox" /><span
              >Learning mode</span
            ></label
          >
        </section>
      </div>
    </div>
    <script>
      import './_game/main';
    </script>
  </body>
</html>
