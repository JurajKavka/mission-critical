---
import ActionButton from '../../../components/ActionButton.astro';
import CancelButton from '../../../components/CancelButton.astro';
import { regions } from './_game/regions';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#02040b" />
    <title>Atlas Rush // Mission Critical</title>
  </head>
  <body>
    <div id="app">
      <header class="hud">
        <div>
          <p class="brand">Mission Critical <span>//</span> Atlas Rush</p>
          <p class="label" id="region-label">Sector 01 / Africa</p>
        </div>
        <div class="hud-stats">
          <div class="telemetry">
            <span class="label">Identified</span
            ><strong id="progress">00&nbsp;/&nbsp;00</strong>
          </div>
          <div id="timer-slot"></div>
        </div>
      </header>
      <main class="playfield">
        <div class="map-heading">
          <span>Survey grid / 01</span><span id="region-code">AFR · 54</span>
        </div>
        <div id="map-slot" class="map-slot"></div>
        <div class="map-key">
          <span><i class="key-target"></i> Current target</span>
          <span><i class="key-guessed"></i> Identified</span>
          <span id="island-markers">Island nations shown as markers</span>
          <span id="learning-hint" hidden
            >Learning mode / Select the target to reveal its name</span
          >
        </div>
      </main>
      <footer class="command">
        <div class="command-heading">
          <div>
            <p class="eyebrow">Target acquired</p>
            <label for="answer">Name the highlighted country</label>
          </div>
          <span class="command-index">01 / 54</span>
        </div>
        <form id="answer-form" autocomplete="off">
          <input
            id="answer"
            name="answer"
            type="text"
            placeholder="Enter country name in English"
            aria-describedby="feedback"
            required
          />
          <ActionButton label="Identify" type="submit" />
          <CancelButton id="skip" label="Skip" />
        </form>
        <p id="feedback" class="feedback" aria-live="polite">
          Type a name, then press Enter. Skip to return to a country later.
        </p>
      </footer>
      <div class="overlay" id="overlay">
        <section
          class="panel start-panel"
          role="dialog"
          aria-modal="true"
          aria-labelledby="start-title"
        >
          <p class="eyebrow">Mission Critical // Sector 01</p>
          <h1 id="start-title">Atlas <em>Rush</em></h1>
          <p class="panel-copy">
            Identify the highlighted countries before the clock runs out.
          </p>
          <fieldset class="region-select">
            <legend>Select a region</legend>
            {regions.map((region, index) => <label class="region-option">
              <input
                type="radio"
                name="region"
                value={region.id}
                checked={index === 0}
              />
              <span>{region.name}</span>
            </label>)}
          </fieldset>
          <ActionButton label="Start survey" />
          <label class="learning-option"
            ><input id="learning-mode" type="checkbox" /><span
              >Learning mode</span
            ></label
          >
        </section>
      </div>
    </div>
    <script>
      import './_game/main';
    </script>
  </body>
</html>
