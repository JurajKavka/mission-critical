---
import { regionMetadata } from '../../../../../games/atlas-rush/data/regions';
import { createElement } from 'react';
import { renderToString } from 'react-dom/server';
import { ServerStyleSheet } from 'styled-components';
import { ResultsDetails } from '../../../../../react-component-library/ResultsDetails';
import { formatTime } from '../../../../../games/atlas-rush/domain/time';
import { getChallengePath } from '../../../../../games/atlas-rush/infrastructure/challenge-url';
import { decodeSharedResult } from '../../../../../games/atlas-rush/infrastructure/share-result';
import GameLayout from '../../../../../layouts/GameLayout.astro';
import '../../../../../styles/global.css';

export const prerender = false;

const shared = decodeSharedResult(Astro.params.token ?? '');
if (!shared) {
  Astro.response.status = 404;
}
const result = shared?.result;
const region = result ? regionMetadata[result.config.regionId].name : '';
const title = result
  ? `${region} result | Atlas Rush`
  : 'Result unavailable | Atlas Rush';
const description = result
  ? `${result.correct} of ${result.total} identified in ${formatTime(result.elapsedSeconds)}.`
  : 'This result link is invalid or unsupported.';
const sheet = new ServerStyleSheet();
const details = result
  ? renderToString(
      sheet.collectStyles(createElement(ResultsDetails, { result })),
    )
  : '';
const detailsStyles = sheet.getStyleTags();
sheet.seal();
---

<GameLayout
  title={title}
  description={description}
  canonicalPath="/games/atlas-rush/"
>
  <meta slot="head" name="robots" content="noindex" />
  <Fragment slot="head" set:html={detailsStyles} />
  <main class="report">
    <nav aria-label="Breadcrumb">
      <a href="/games/atlas-rush/">Atlas Rush</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">Shared result</span>
    </nav>
    {result ? (
      <section>
        <p class="report-status">Unverified result</p>
        <h1>
          {result.finishReason === 'completed'
            ? 'Atlas complete'
            : 'Time is up'}
        </h1>
        {shared?.displayName && <p class="player-name">{shared.displayName}</p>}
        <Fragment set:html={details} />
        <a class="challenge" href={getChallengePath(result.config)}
          >Try this challenge</a
        >
      </section>
    ) : (
      <section>
        <h1>Result unavailable</h1>
        <p>This result link is invalid or unsupported.</p>
        <a class="challenge" href="/games/atlas-rush/">Back to Atlas Rush</a>
      </section>
    )}
  </main>
</GameLayout>

<style>
  .report {
    max-width: 64rem;
    margin-inline: auto;
    padding: 0 1rem 2rem;
    color: var(--color-primary-text);
  }
  nav {
    min-height: 3.25rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    border-bottom: 1px solid var(--cyan-border);
    color: var(--color-secondary-text);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }
  section {
    margin: 0.5rem auto 0;
    padding: clamp(1rem, 4vw, 2rem);
    max-width: 34rem;
    border: 1px solid var(--cyan-border);
    background: linear-gradient(
      155deg,
      var(--color-nebula-blue),
      var(--color-space-blue) 46%
    );
  }
  h1 {
    margin: 0 0 1rem;
    font-size: clamp(1.75rem, 5vw, 2.5rem);
    line-height: 1;
    text-transform: uppercase;
    letter-spacing: -0.04em;
  }
  .report-status {
    margin: 0 0 0.5rem;
    color: var(--color-secondary-text);
    font-size: 0.625rem;
    line-height: 1.4;
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }
  .player-name {
    margin-top: -0.5rem;
    color: var(--color-secondary-text);
    overflow-wrap: anywhere;
  }
  a {
    color: var(--color-cyan);
    text-underline-offset: 0.2em;
  }
  .challenge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.625rem;
    padding: 0.5rem 1rem;
    border: 1px solid var(--color-cyan);
    background: var(--cyan-soft);
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: 0.6875rem;
    font-weight: 700;
  }
  .challenge:hover {
    background: var(--cyan-border);
  }
  .challenge:focus-visible {
    outline: 0;
    box-shadow: inset 0 0 0 1px var(--color-cyan);
  }
</style>
